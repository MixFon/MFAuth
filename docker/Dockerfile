# =============================================================================
# Стадия 1: сборка бинарника
# golang:1.26-alpine — официальный образ Go на базе Alpine Linux.
# Alpine весит ~5 МБ против ~900 МБ у debian-образов.
# =============================================================================
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Копируем только файлы зависимостей перед исходным кодом.
# Docker кэширует каждую инструкцию как отдельный слой.
# Если go.mod и go.sum не менялись — go mod download берётся из кэша,
# даже если исходный код изменился. Это ускоряет повторные сборки.
COPY go.mod go.sum ./
RUN go mod download

# Копируем исходный код после загрузки зависимостей.
COPY . .

# Собираем статический бинарник.
# CGO_ENABLED=0  — отключаем CGo, чтобы бинарник не зависел от системных C-библиотек.
#                  Без этого бинарник не запустится на чистом Alpine (там нет glibc).
# GOOS=linux     — явно указываем целевую ОС (на случай сборки с Mac/Windows).
# -ldflags="-w -s" — убираем отладочную информацию и таблицу символов.
#                    Уменьшает размер бинарника примерно на 30%.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o mfauth ./cmd/server

# =============================================================================
# Стадия 2: минимальный runtime-образ
# Берём чистый Alpine — без Go-компилятора, без исходников, без кэша модулей.
# Итоговый образ ~15 МБ вместо ~400 МБ если бы оставили golang:alpine.
# =============================================================================
FROM alpine:latest

# ca-certificates — корневые SSL-сертификаты.
#                   Нужны если сервис будет делать HTTPS-запросы наружу.
# tzdata          — база данных временных зон.
#                   Нужна для корректной работы time.LoadLocation в Go.
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Копируем только скомпилированный бинарник из стадии builder.
# Всё остальное (исходники, компилятор, кэш модулей) в финальный образ не попадает.
COPY --from=builder /app/mfauth .

# Документируем порт — реальный проброс настраивается в docker-compose.
EXPOSE 8080

CMD ["./mfauth"]
